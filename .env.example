# OnlyYou Web Platform Environment Variables
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_DOMAIN=onlyyouhub.com

# OnlyYou | App Backend API (Fastify)
ONLYYOU_API_URL=http://localhost:3000/api/v1
ONLYYOU_API_SECRET=onlyyou_default_super_secret_key_32_characters!

# Discord Integration
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/onlyyou

# Session Secret (Iron session / JWT)
SESSION_SECRET=onlyyou_super_secure_session_secret_at_least_32_chars!
